{
  "name": "msilabs/bkash",
  "description": "bKash Tokenized Checkout (v2) payment gateway for Laravel, with refund, query, agreement and multi-merchant support.",
  "keywords": [
    "bKash",
    "bkash laravel",
    "bkash tokenized",
    "bkash refund",
    "payment gateway",
    "bangladesh",
    "laravel",
    "laravel-package"
  ],
  "homepage": "https://github.com/msilabs/bkash",
  "type": "library",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/msilabs/bkash/issues",
    "source": "https://github.com/msilabs/bkash"
  },
  "authors": [
    {
      "name": "msisaif",
      "email": "msi313.bd@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "guzzlehttp/guzzle": "^7.2",
    "illuminate/cache": "^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/http": "^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/log": "^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/routing": "^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^9.5|^10.5|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Msilabs\\Bkash\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Msilabs\\Bkash\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "format": "vendor/bin/pint"
  },
  "extra": {
    "branch-alias": {
      "dev-3.x": "3.x-dev"
    },
    "laravel": {
      "providers": [
        "Msilabs\\Bkash\\BkashServiceProvider"
      ],
      "aliases": {
        "Bkash": "Msilabs\\Bkash\\Facades\\Bkash"
      }
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
