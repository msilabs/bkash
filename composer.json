{
  "name": "msilabs/bkash",
  "description": "bKash Payment Gateway API for Laravel Framework.",
  "keywords": [
    "bKash",
    "bKash laravel",
    "payment gateway",
    "laravel-package"
  ],
  "homepage": "https://github.com/msilabs/bkash",
  "type": "library",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/msilabs/bkash/issues",
    "source": "https://github.com/msilabs/bkash"
  },
  "authors": [
    {
      "name": "msisaif",
      "email": "msi313.bd@gmail.com"
    }
  ],
  "require": {
    "php": "^7.4|^8.0",
    "illuminate/support": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
  },
  "autoload": {
    "psr-4": {
